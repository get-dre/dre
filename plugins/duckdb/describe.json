{
  "source/duckdb": {
    "capabilities": [
      "catalog",
      "check",
      "load",
      "read_only",
      "sessions",
      "validate"
    ],
    "connection_fields": [
      {
        "name": "path",
        "description": "DuckDB database file (relative to the project), or :memory:",
        "required": false,
        "secret": false,
        "default": ":memory:"
      },
      {
        "name": "threads",
        "description": "number of threads DuckDB may use",
        "required": false,
        "secret": false,
        "kind": "integer"
      },
      {
        "name": "memory_limit",
        "description": "DuckDB memory limit, e.g. 4GB",
        "required": false,
        "secret": false
      }
    ],
    "option_fields": [],
    "identifier_quote": "\"",
    "sql_dialect": {
      "parser": "duckdb",
      "identifier_quote": "\"",
      "identifier_case": "insensitive",
      "literal_style": "doubling",
      "hex_literal": null,
      "denied_functions": [
        "read_text",
        "read_blob",
        "read_csv",
        "read_csv_auto",
        "read_json",
        "read_json_auto",
        "read_json_objects",
        "read_json_objects_auto",
        "read_ndjson",
        "read_ndjson_auto",
        "read_ndjson_objects",
        "read_parquet",
        "parquet_scan",
        "parquet_metadata",
        "parquet_schema",
        "parquet_file_metadata",
        "parquet_kv_metadata",
        "read_xlsx",
        "sniff_csv",
        "glob",
        "delta_scan",
        "iceberg_scan",
        "iceberg_metadata",
        "iceberg_snapshots",
        "sqlite_scan",
        "sqlite_attach",
        "postgres_scan",
        "postgres_query",
        "postgres_attach",
        "mysql_query",
        "query",
        "query_table",
        "getenv",
        "duckdb_secrets",
        "duckdb_settings",
        "which_secret"
      ],
      "file_formats": [],
      "read_only_notice": null
    }
  }
}
