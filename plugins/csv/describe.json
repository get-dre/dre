{
  "format/csv": {
    "capabilities": [
      "validate"
    ],
    "connection_fields": [],
    "option_fields": [
      {
        "name": "delimiter",
        "type": "char",
        "description": "separates fields",
        "required": false,
        "default": ","
      },
      {
        "name": "quote",
        "type": "char",
        "description": "wraps quoted fields; doubled inside them",
        "required": false,
        "default": "\""
      },
      {
        "name": "quoting",
        "type": "string",
        "description": "which fields are quoted: only where needed, all, text columns, or none",
        "required": false,
        "default": "minimal",
        "choices": [
          "minimal",
          "all",
          "strings",
          "none"
        ]
      },
      {
        "name": "header",
        "type": "boolean",
        "description": "write the column names first",
        "required": false,
        "default": true
      },
      {
        "name": "line_ending",
        "type": "string",
        "description": "ends each line",
        "required": false,
        "default": "\r\n",
        "choices": [
          "\n",
          "\r\n"
        ]
      },
      {
        "name": "encoding",
        "type": "string",
        "description": "text encoding, e.g. utf-8, latin1, windows-1252",
        "required": false,
        "default": "utf-8"
      },
      {
        "name": "null",
        "type": "string",
        "description": "written for a null value",
        "required": false,
        "default": ""
      },
      {
        "name": "byte_order_mark",
        "type": "boolean",
        "description": "start a UTF-8 file with a byte order mark",
        "required": false,
        "default": false
      }
    ]
  },
