{
  "source/postgres": {
    "capabilities": [
      "check",
      "load",
      "read_only",
      "sessions",
      "validate"
    ],
    "connection_fields": [
      {
        "name": "host",
        "description": "server host name",
        "required": false,
        "secret": false,
        "default": "localhost"
      },
      {
        "name": "port",
        "description": "server port",
        "required": false,
        "secret": false,
        "default": 5432,
        "kind": "integer"
      },
      {
        "name": "user",
        "description": "user name",
        "required": true,
        "secret": false
      },
      {
        "name": "password",
        "description": "password",
        "required": false,
        "secret": true
      },
      {
        "name": "database",
        "description": "database name",
        "required": false,
        "secret": false
      },
      {
        "name": "dbname",
        "description": "libpq's name for `database`",
        "required": false,
        "secret": false,
        "manual": true
      },
      {
        "name": "sslmode",
        "description": "disable, prefer, require, verify-ca or verify-full",
        "required": false,
        "secret": false,
        "default": "prefer",
        "kind": "string",
        "choices": [
          "disable",
          "prefer",
          "require",
          "verify-ca",
          "verify-full"
        ]
      },
      {
        "name": "sslrootcert",
        "description": "CA certificate for verify-ca and verify-full",
        "required": false,
        "secret": false,
        "manual": true,
        "kind": "path"
      },
      {
        "name": "schema",
        "description": "schema to put first on the search path",
        "required": false,
        "secret": false
      },
      {
        "name": "role",
        "description": "SET ROLE after connecting",
        "required": false,
        "secret": false,
        "manual": true
      },
      {
        "name": "ssh",
        "description": "reach the server through an SSH bastion (a block of settings)",
        "required": false,
        "secret": true,
        "manual": true,
        "kind": "map"
      },
      {
        "name": "connect_timeout",
        "description": "how long to wait for a connection (`30s`, `2m`, or seconds)",
        "required": false,
        "secret": false,
        "default": "30s",
        "manual": true,
        "kind": "duration"
      },
      {
        "name": "retries",
        "description": "how many times to try again after a temporary error (0: never)",
        "required": false,
        "secret": false,
        "default": 3,
        "manual": true,
        "kind": "integer"
      }
    ],
    "option_fields": [],
    "identifier_quote": "\""
  }
}
