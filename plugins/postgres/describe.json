{
  "source/postgres": {
    "capabilities": [
      "catalog",
      "check",
      "load",
      "read_only",
      "sessions",
      "validate"
    ],
    "connection_fields": [
      {
        "name": "host",
        "description": "server host name",
        "required": false,
        "secret": false,
        "default": "localhost"
      },
      {
        "name": "port",
        "description": "server port",
        "required": false,
        "secret": false,
        "default": 5432,
        "kind": "integer"
      },
      {
        "name": "user",
        "description": "user name",
        "required": true,
        "secret": false
      },
      {
        "name": "password",
        "description": "password",
        "required": false,
        "secret": true
      },
      {
        "name": "database",
        "description": "database name",
        "required": false,
        "secret": false
      },
      {
        "name": "dbname",
        "description": "libpq's name for `database`",
        "required": false,
        "secret": false,
        "manual": true
      },
      {
        "name": "sslmode",
        "description": "disable, prefer, require, verify-ca or verify-full",
        "required": false,
        "secret": false,
        "default": "prefer",
        "kind": "string",
        "choices": [
          "disable",
          "prefer",
          "require",
          "verify-ca",
          "verify-full"
        ]
      },
      {
        "name": "sslrootcert",
        "description": "CA certificate for verify-ca and verify-full",
        "required": false,
        "secret": false,
        "manual": true,
        "kind": "path"
      },
      {
        "name": "schema",
        "description": "schema to put first on the search path",
        "required": false,
        "secret": false
      },
      {
        "name": "role",
        "description": "SET ROLE after connecting",
        "required": false,
        "secret": false,
        "manual": true
      },
      {
        "name": "ssh",
        "description": "reach the server through an SSH bastion (a block of settings)",
        "required": false,
        "secret": true,
        "manual": true,
        "kind": "map"
      },
      {
        "name": "connect_timeout",
        "description": "how long to wait for a connection (`30s`, `2m`, or seconds)",
        "required": false,
        "secret": false,
        "default": "30s",
        "manual": true,
        "kind": "duration"
      },
      {
        "name": "retries",
        "description": "how many times to try again after a temporary error (0: never)",
        "required": false,
        "secret": false,
        "default": 3,
        "manual": true,
        "kind": "integer"
      },
      {
        "name": "retry_wait",
        "description": "the first wait before trying again (`30s`), doubling each try; a server's Retry-After wins",
        "required": false,
        "secret": false,
        "manual": true,
        "kind": "duration"
      },
      {
        "name": "max_retry_wait",
        "description": "the longest wait between tries (`10m`)",
        "required": false,
        "secret": false,
        "default": "10m",
        "manual": true,
        "kind": "duration"
      }
    ],
    "option_fields": [],
    "identifier_quote": "\"",
    "sql_dialect": {
      "parser": "postgres",
      "identifier_quote": "\"",
      "identifier_case": "lower_unless_quoted",
      "literal_style": "hex",
      "hex_literal": "convert_from(decode('{hex}', 'hex'), 'UTF8')",
      "denied_functions": [
        "pg_read_file",
        "pg_read_binary_file",
        "pg_ls_dir",
        "pg_ls_logdir",
        "pg_ls_waldir",
        "pg_ls_tmpdir",
        "pg_ls_archive_statusdir",
        "pg_stat_file",
        "lo_import",
        "lo_export",
        "lo_get",
        "lo_open",
        "loread",
        "dblink",
        "dblink_exec",
        "dblink_connect",
        "dblink_send_query",
        "pg_execute_server_program",
        "query_to_xml",
        "query_to_xml_and_xmlschema",
        "query_to_xmlschema",
        "cursor_to_xml",
        "cursor_to_xmlschema",
        "table_to_xml",
        "table_to_xml_and_xmlschema",
        "database_to_xml",
        "schema_to_xml",
        "current_setting",
        "pg_reload_conf",
        "pg_terminate_backend",
        "pg_cancel_backend"
      ],
      "file_formats": [],
      "read_only_notice": null
    }
  }
}
